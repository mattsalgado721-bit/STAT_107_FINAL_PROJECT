library(tidyverse)
cleaned_df <- read_csv("cleaned_clinical_data.csv") %>%
mutate(Reccurance = factor(RFS_BOOL, levels = c(0,1),
labels = c("No Reccurance", "Recurrance")))
ggplot(cleaned_df, aes(TUMOR_SIZE, LYMPH_NODES_EXAMINED_POSITIVE, color = Reccurance)) +
geom_point(size = 2, alpha = 2) + scale_color_manual(values = c("hotpink2", "lightskyblue")) +
labs(title = "Tumor size vs. positive lymph nodes",
x = "Tumor size",
y = "Positive lymph nodes")
library(tidyverse)
cleaned_df <- read_csv("cleaned_clinical_data.csv") %>%
mutate(Reccurance = factor(RFS_BOOL, levels = c(0,1),
labels = c("No Reccurance", "Recurrance")))
ggplot(cleaned_df, aes(TUMOR_SIZE, LYMPH_NODES_EXAMINED_POSITIVE, color = Reccurance)) +
geom_point(size = 2, alpha = 0.7) + scale_color_manual(values = c("hotpink2", "lightskyblue")) +
labs(title = "Tumor size vs. positive lymph nodes",
x = "Tumor size",
y = "Positive lymph nodes")
# histograms
hist(clinical_data$AGE_AT_DIAGNOSIS, main = "Distribution of Age at Breast Cancer Diagnosis", xlab = "Age at Diagnosis (Years)", ylab = "# of Patients", breaks = seq(20,100, by = 5), col = "cadetblue")
# histograms
hist(cleaned_clinical_data$AGE_AT_DIAGNOSIS, main = "Distribution of Age at Breast Cancer Diagnosis", xlab = "Age at Diagnosis (Years)", ylab = "# of Patients", breaks = seq(20,100, by = 5), col = "cadetblue")
# histograms
hist(cleaned_df$AGE_AT_DIAGNOSIS, main = "Distribution of Age at Breast Cancer Diagnosis", xlab = "Age at Diagnosis (Years)", ylab = "# of Patients", breaks = seq(20,100, by = 5), col = "cadetblue")
hist(cleaned_df$TUMOR_SIZE, main = "Distribution of Breast Tumor Sizes", xlab = "Tumor Size (mm)", ylab = "# of Patients", col = "cadetblue1")
boxplot(TUMOR_SIZE ~ OS_BOOL,
data = cleaned_df,
main = "Overall Survival vs. Tumor Size",
xlab = "Overall Survival",
ylab = "Tumor Size (mm)")
legend("topleft", c("0 = Living", "1 = Deceased"), cex = 0.8)
boxplot(AGE_AT_DIAGNOSIS ~ OS_BOOL,
data = cleaned_df,
main = "Overall Survival vs. Age at Diagnosis",
xlab = "Overall Survival",
ylab = "Age at Diagnosis")
legend("topleft", c("0 = Living", "1 = Deceased"), cex = 0.7)
library(tidyverse)
cleaned_df <- read_csv("cleaned_clinical_data.csv") %>%
mutate(Reccurance = factor(RFS_BOOL, levels = c(0,1),
labels = c("No Reccurance", "Recurrance")))
ggplot(cleaned_df, aes(TUMOR_SIZE, LYMPH_NODES_EXAMINED_POSITIVE, color = Reccurance)) +
geom_point(size = 2, alpha = 0.7) + scale_color_manual(values = c("hotpink2", "lightskyblue")) +
labs(title = "Tumor size vs. positive lymph nodes",
x = "Tumor size",
y = "Positive lymph nodes")
# histograms
hist(cleaned_df$AGE_AT_DIAGNOSIS, main = "Distribution of Age at Breast Cancer Diagnosis", xlab = "Age at Diagnosis (Years)", ylab = "# of Patients", breaks = seq(20,100, by = 5), col = "cadetblue")
hist(cleaned_df$TUMOR_SIZE, main = "Distribution of Breast Tumor Sizes", xlab = "Tumor Size (mm)", ylab = "# of Patients", col = "cadetblue1")
boxplot(TUMOR_SIZE ~ OS_BOOL,
data = cleaned_df,
main = "Overall Survival vs. Tumor Size",
xlab = "Overall Survival",
ylab = "Tumor Size (mm)")
legend("topleft", c("0 = Living", "1 = Deceased"), cex = 0.8)
boxplot(AGE_AT_DIAGNOSIS ~ OS_BOOL,
data = cleaned_df,
main = "Overall Survival vs. Age at Diagnosis",
xlab = "Overall Survival",
ylab = "Age at Diagnosis")
legend("topleft", c("0 = Living", "1 = Deceased"), cex = 0.7)
View(cleaned_df)
ggplot(cleaned_df, aes(LYMPH_NODES_EXAMINED_POSITIVE, RFS_BOOL)) +
geom_jitter(height = 0.05, alpha = 0.4) +
geom_smooth(method = "glm", method.args = list(family = "binomial"),
color = "#6959CD") +
labs(title = "Probability of recurrence by positive lymph nodes",
x = "Positive lymph nodes", y = "P(recurrence)")
ggplot(cleaned_df, aes(LYMPH_NODES_EXAMINED_POSITIVE, RFS_BOOL)) +
geom_jitter(height = 0.05) +
labs(title = "Probability of recurrence by positive lymph nodes",
x = "Positive lymph nodes", y = "Probability of recurrence")
cleaned_df %>%
mutate(node_group = cut(LYMPH_NODES_EXAMINED_POSITIVE,
breaks = c(-1, 0, 3, 10, Inf),
labels = c("0", "1-3", "4-10", "11+"))) %>%
group_by(node_group) %>%
summarise(recurrence_rate = mean(RFS_BOOL)) %>%
ggplot(aes(node_group, recurrence_rate)) +
geom_col() +
labs(title = "Recurrence rate by number of positive lymph nodes",
x = "Positive lymph nodes", y = "Proportion with recurrence")
ggplot(cleaned_df, aes(x = factor(RFS_BOOL, labels = c("No recurrence", "Recurrence")),
y = LYMPH_NODES_EXAMINED_POSITIVE)) +
geom_violin(fill = "lightblue") +
labs(x = "", y = "Positive lymph nodes")
ggplot(cleaned_df, aes(x = factor(RFS_BOOL, labels = c("No recurrence", "Recurrence")),
y = LYMPH_NODES_EXAMINED_POSITIVE)) +
geom_violin(fill = "#CD5555") +
labs(x = "", y = "Positive lymph nodes")
ggplot(cleaned_df, aes(x = factor(RFS_BOOL, labels = c("No recurrence", "Recurrence")),
y = LYMPH_NODES_EXAMINED_POSITIVE)) +
geom_violin(fill = "lightblue") +
labs(x = "", y = "Positive lymph nodes")
ggplot(cleaned_df, aes(x = factor(RFS_BOOL, labels = c("No recurrence", "Recurrence")),
y = LYMPH_NODES_EXAMINED_POSITIVE)) +
geom_violin(fill = "lightblue") +
labs(title = "Relationship between recurrance and examined lymph nodes", x = "", y = "Positive lymph nodes")
ggplot(cleaned_df, aes(x = factor(RFS_BOOL, labels = c("No recurrence", "Recurrence")),
y = LYMPH_NODES_EXAMINED_POSITIVE)) +
geom_boxplot() +
labs(title = "Positive lymph nodes by recurrence",
x = "", y = "Positive lymph nodes")
